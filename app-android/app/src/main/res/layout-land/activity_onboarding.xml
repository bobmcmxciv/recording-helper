<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: step title and buttons on the left, step content on the right. Ids match layout/activity_onboarding.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:navigationContentDescription="关闭向导"
        app:navigationIcon="@drawable/ic_close"
        app:title="首次设置" />

    <LinearLayout
        android:id="@+id/panes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tvStep"
                style="@style/Text.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="首次设置 · 1 / 5" />

            <TextView
                android:id="@+id/tvTitle"
                style="@style/Text.PageTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="让录音变成可以推进的事" />

            <TextView
                android:id="@+id/tvSubtitle"
                style="@style/Text.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:orientation="horizontal"
        android:paddingHorizontal="0dp"
        android:paddingVertical="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSecondary"
            style="@style/Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="稍后再说" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrimary"
            style="@style/Button.Filled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="140dp"
            android:text="开始" />
    </LinearLayout>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="@dimen/page_padding"
                android:paddingBottom="24dp">

            <!-- Step 1: welcome -->
            <LinearLayout
                android:id="@+id/step1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card.Hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="@color/hero_on"
                            android:textStyle="bold"
                            android:text="只在你的手机里" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/hero_muted"
                            android:text="录音不离开手机。在本机转成文字，整理纪要与待办。约 5 分钟完成设置，就能看到第一条转写。" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <TextView
                            style="@style/Text.SectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="三步准备，就能开始" />

                        <TextView
                            style="@style/Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="①  准备语音模型\n②  选择录音目录\n③  确认要处理的范围" />

                        <TextView
                            style="@style/Text.Muted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="首次下载模型需要联网；转写本身可以离线运行。在线整理需要单独同意后才会开启。" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Step 2: models -->
            <LinearLayout
                android:id="@+id/step2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/Text.SectionTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="语音识别 · SenseVoice" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipAsr"
                                style="@style/Chip.Status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="false"
                                android:text="必需" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvAsrInfo"
                            style="@style/Text.Muted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="sv.tflite · tokens.json · am.mvn · 约 450 MB" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressAsr"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:visibility="gone"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />

                        <TextView
                            android:id="@+id/tvAsrProgress"
                            style="@style/Text.Muted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:visibility="gone"
                            android:text="" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAsrDownload"
                                style="@style/Button.Filled"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:text="从推荐来源下载" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAsrImport"
                                style="@style/Button.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:text="本地导入" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <TextView
                            style="@style/Text.SectionTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="纪要与待办 · 可选" />

                        <TextView
                            android:id="@+id/tvLlmInfo"
                            style="@style/Text.Muted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="本地 Qwen 模型约 2.4 GB，离线整理；也可以使用在线 AI 服务，或暂时只转写。" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressLlm"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:visibility="gone"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />

                        <TextView
                            android:id="@+id/tvLlmProgress"
                            style="@style/Text.Muted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:visibility="gone"
                            android:text="" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLlmDownload"
                            style="@style/Button.Tonal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="下载本地模型（约 2.4 GB）" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLlmOnline"
                            style="@style/Button.Tonal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="使用在线 AI 服务" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLlmSkip"
                            style="@style/Button.Text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="暂不整理，只转写" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Step 3: sources -->
            <LinearLayout
                android:id="@+id/step3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <LinearLayout
                        android:id="@+id/listSources"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvSourcesHint"
                    style="@style/Text.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="先检查常见的录音目录；授权后才会读取文件。" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMediaPermission"
                    style="@style/Button.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:icon="@drawable/ic_check"
                    android:text="一键授权读取录音文件" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPickFolder"
                    style="@style/Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:icon="@drawable/ic_folder"
                    android:text="手动选择录音目录" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAllFiles"
                    style="@style/Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="高级 · 授予全部文件权限，自动发现" />
            </LinearLayout>

            <!-- Step 4: range -->
            <LinearLayout
                android:id="@+id/step4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <RadioGroup
                            android:id="@+id/rangeGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rangeNew"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="52dp"
                                android:text="仅开启后新增的录音" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rangeRecent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:minHeight="52dp"
                                android:text="最近 N 天及新增（推荐从 7 天开始）" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rangeAll"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="52dp"
                                android:text="全部已有及新增的录音" />

                            <com.google.android.material.radiobutton.MaterialRadioButton
                                android:id="@+id/rangeOff"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="52dp"
                                android:text="暂不开启，之后手动导入" />
                        </RadioGroup>

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/daysGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="8dp"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/days7"
                                style="@style/Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="7 天" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/days14"
                                style="@style/Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="14 天" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/days30"
                                style="@style/Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="30 天" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/days90"
                                style="@style/Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="90 天" />
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Text.Muted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="处理历史录音可能耗时较长并增加耗电，建议接上电源后在后台运行。范围随时可以在设置里修改。" />
            </LinearLayout>

            <!-- Step 5: processing -->
            <LinearLayout
                android:id="@+id/step5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvProcState"
                                style="@style/Text.SectionTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="正在处理" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipProc"
                                style="@style/Chip.Status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="false"
                                android:text="0 / 0" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvProcFound"
                            style="@style/Text.Muted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="正在检查录音目录…" />

                        <TextView
                            android:id="@+id/tvProcFile"
                            style="@style/Text.Body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:textStyle="bold"
                            android:text="" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progressProc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            app:trackCornerRadius="4dp"
                            app:trackThickness="8dp" />

                        <TextView
                            android:id="@+id/tvProcText"
                            style="@style/Text.Muted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_rounded_tonal"
                            android:minHeight="96dp"
                            android:padding="12dp"
                            android:text="正在识别，文字将在这里逐段出现…" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnProcPause"
                            style="@style/Button.Tonal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            app:icon="@drawable/ic_pause"
                            android:text="暂停" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Step 6: done -->
            <LinearLayout
                android:id="@+id/step6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Card.Hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="22dp">

                        <TextView
                            android:id="@+id/tvDoneTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceHeadlineSmall"
                            android:textColor="@color/hero_on"
                            android:textStyle="bold"
                            android:text="已转写 0 条" />

                        <TextView
                            android:id="@+id/tvDoneSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/hero_muted"
                            android:text="文字已保存在本机。" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</LinearLayout>
